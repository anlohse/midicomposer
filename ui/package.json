{
  "name": "midi-composer-ui",
  "version": "0.1.0",
  "description": "MIDI Composer UI",
  "scripts": {
    "dev": "parcel public/index.html",
    "//build": "--public-url ./ keeps asset URLs relative to index.html. The release build serves the page from a custom scheme with no real host component, where an absolute /path has nothing sensible to resolve against.",
    "build": "parcel build public/index.html --public-url ./",
    "clean": "rimraf dist .parcel-cache .test-build",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/tests/**/*.test.js\""
  },
  "dependencies": {
    "lit": "^3.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "parcel": "^2.12.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5"
  }
}
